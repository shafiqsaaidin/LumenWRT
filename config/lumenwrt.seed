# LumenWRT seed config for Arcadyan AW1000 (branch ppe-nss: openwrt-ppe-nss)
# Expanded with `make defconfig` by scripts/build.sh. Every "=y" line must
# survive defconfig and every "# ... is not set" line must stay off.
# Commercial product: only packages licensed for redistribution (CLAUDE.md).

#####################################################################
# Target
#####################################################################
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=y

#####################################################################
# Branding
#####################################################################
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="LumenWRT"
# Keep our custom feeds out of the image's apk repository list.
# CONFIG_FEED_nss is not set
# CONFIG_FEED_wwand is not set

#####################################################################
# Offload: PPE (wired, via the fw4 flowtable; enabled on first boot by the
# target's 99-flow-offload) + NSS cores for Wi-Fi and the raw-IP modem path.
# No ECM / qca-nss-drv / vendor NSS stack on this branch.
#####################################################################
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_kmod-ramoops=y

#####################################################################
# Toolchain
#####################################################################
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a53"
CONFIG_USE_GC_SECTIONS=y
# Per-package logs in openwrt/logs/ (uploaded by CI on failure)
CONFIG_BUILD_LOG=y

#####################################################################
# SSL / Wi-Fi: OpenSSL everywhere, no mixed TLS libraries
#####################################################################
CONFIG_PACKAGE_libustream-openssl=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
CONFIG_PACKAGE_libopenssl=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

#####################################################################
# LuCI
#####################################################################
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-mod-dashboard=y
CONFIG_PACKAGE_luci-mod-netstat=y

#####################################################################
# Modem: Quectel RG500Q-EA over USB, upstream qmi_wwan (raw-IP, QMAP via
# rmnet), managed by wwand (GPL-2.0-only). AW1000 board profile is built in.
#####################################################################
CONFIG_PACKAGE_wwand=y
CONFIG_PACKAGE_wwand-qmi=y
CONFIG_PACKAGE_luci-app-wwand=y
CONFIG_PACKAGE_luci-proto-wwand=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
# QModem / Quectel vendor stack: not licensed for commercial use
# CONFIG_PACKAGE_kmod-qmi_wwan_q is not set
# CONFIG_PACKAGE_quectel-cm is not set

#####################################################################
# Networking extras (kernel modules must be built in: upstream kmods don't
# match this kernel)
#####################################################################
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# xlite tproxy mode (nft "tproxy to"); pulls kmod-nf-tproxy
CONFIG_PACKAGE_kmod-nft-tproxy=y

#####################################################################
# Tools
#####################################################################
CONFIG_PACKAGE_adb=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
