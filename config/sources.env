# Pinned sources for reproducible LumenWRT builds.
# Bump a ref deliberately, rebuild, test on the device, then commit.

# Base: qosmio NSS fork of OpenWrt, 25.12 branch (kernel 6.12)
OPENWRT_REPO="https://github.com/qosmio/openwrt-ipq.git"
OPENWRT_REF="d6848fa2ea00193b5b7d3973e3990da7f608027c"   # 25.12-nss @ 2026-06-06

# QModem: v3.4.0_rc3.1 (needed for qmodem-smsd + VoIP/SIP; 3.3.0 lacks qmodem-sipd)
QMODEM_REPO="https://github.com/FUjr/QModem.git"
QMODEM_REF="f8f2835983f135823b8a0a4671d226bb18e2b41c"     # tag v3.4.0_rc3.1

# modemdata (not in the 25.12 feeds): backend + LuCI app
MODEMDATA_REPO="https://github.com/obsy/modemdata.git"
MODEMDATA_REF="fbdc0b6a720647642e99c6fc8db933a767c9ead0"   # 2026-10-18
MODEMDATA_LUCI_REPO="https://github.com/4IceG/luci-app-modemdata.git"
MODEMDATA_LUCI_REF="502bc313bbb3fd878368fcb8d5c2db28f66dc3d4" # 2026-11-02

# Feed overrides: a package directory from another repo/ref replaces the one in
# the feed checkout (see apply_overrides in scripts/build.sh).
# luci-mod-dashboard from LuCI master: the redesign is in 25.12 already; master
# adds temperature monitoring and a WAN traffic fix (wwan + @wwan IPv6 alias).
LUCI_MASTER_REPO="https://github.com/openwrt/luci.git"
DASHBOARD_REF="8d1aecd0216a02ad52c830e9a03c21da734bf630"  # master @ 2026-11-25

# Extra single-package repos, cloned into openwrt/package/lumenwrt/<name>
AURORA_REPO="https://github.com/eamonxg/luci-theme-aurora.git"
AURORA_REF="298dbcc74ddf820923a51285fb0826d429e5d7ca"     # 1.4.3
AURORA_CFG_REPO="https://github.com/eamonxg/luci-app-aurora-config.git"
AURORA_CFG_REF="a5299ce0144859f47683ec3bc40805bf616f534f"
# "At a Glance" widget on Status > Overview (by the ShiranekoWrt author).
# Note: looks up the public IP via api.ipify.org every 5 min while the page is open.
NETSTAT_REPO="https://github.com/cjayacopra/luci-mod-netstat.git"
NETSTAT_REF="ddd2794b6b0cf6c9ff34b70858f249559822ee02"    # 1.0.0, 2026-08-03
