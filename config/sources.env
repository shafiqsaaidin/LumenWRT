# Pinned sources for reproducible LumenWRT builds (branch: ppe-nss).
# Bump a ref deliberately, rebuild, test on the device, then commit.
# Every package that ends up in the image must be licensed for commercial
# redistribution (see CLAUDE.md "Business model").

# Base: openwrt-ppe-nss — OpenWrt main + upstream qca_edma/qca_ppe (PPE wired
# offload via the fw4 flowtable) + nss-wifi-drv (NSS Wi-Fi and raw-IP modem
# offload). Kernel 6.18. GPL-2.0.
OPENWRT_REPO="https://github.com/JuliusBairaktaris/openwrt-ppe-nss.git"
OPENWRT_REF="0514ded08c1d4656d0efe90ca00e5f6cc5ebbb7b"   # ppe-nss @ 2026-11-21

# Feeds, written verbatim to feeds.conf ("src-git <name> <url>^<commit>").
# The OpenWrt main feeds are pinned to their last commit before OPENWRT_REF.
FEEDS="
src-git packages https://github.com/openwrt/packages.git^26ecf879d403c39d77d1d475dc4efb76dd3b815c
src-git luci https://github.com/openwrt/luci.git^f372739940fceda9c2908237cc0336634f3a210c
src-git routing https://github.com/openwrt/routing.git^ea8633da9c461a9bdc62a0323439d31180762e03
src-git telephony https://github.com/openwrt/telephony.git^06feffc2c154993f555b43756ef7db6dd7e58225
src-git video https://github.com/openwrt/video.git^6a3b5fd6e963f41caa73ef4f691e156d467e2894
src-git nss https://github.com/JuliusBairaktaris/nss-packages.git^1f60d7e9409930bbd298eae1831c5b76d21eb1d2
src-git wwand https://github.com/ddimension/openwrt-repo.git^6f8f5622abf4fd5dadfc8686081ebdf94a1f1a64
"
# nss:   only nss-firmware (Qualcomm binary licence: unmodified, Qualcomm chips).
# wwand: modem manager (GPL-2.0-only) + luci-app/proto-wwand (GPL-2.0-only);
#        the feed pins each package's source commit itself.

# Feed overrides: "<feed>|<path-in-feed>|<repo>|<commit>" per line
# (none: luci main already carries the newest luci-mod-dashboard).
OVERRIDES=""

# Single-package repos cloned into openwrt/package/lumenwrt/<name>:
# "<name>|<repo>|<commit>" per line.
EXTRA_PKGS="
luci-theme-aurora|https://github.com/eamonxg/luci-theme-aurora.git|298dbcc74ddf820923a51285fb0826d429e5d7ca
luci-app-aurora-config|https://github.com/eamonxg/luci-app-aurora-config.git|a5299ce0144859f47683ec3bc40805bf616f534f
luci-mod-netstat|https://github.com/cjayacopra/luci-mod-netstat.git|ddd2794b6b0cf6c9ff34b70858f249559822ee02
"
# Aurora (+config): Apache-2.0. netstat: GPL-3.0; looks up the public IP via
# api.ipify.org every 5 min while Status > Overview is open.
