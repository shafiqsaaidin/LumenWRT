luci-app-qmodem-next: create $(1)/www before copying htdocs

Without it, cp copies htdocs/luci-static AS www, so the views land in
/www/resources/ and LuCI 404s on view/qmodem/overview.js. Fixed upstream
in a06124f9a0 (2026-09-14), after our pinned v3.4.0_rc3.1.
Drop this patch when QMODEM_REF includes that commit.
---
diff --git a/luci/luci-app-qmodem-next/Makefile b/luci/luci-app-qmodem-next/Makefile
index 36e78e3..967c64f 100644
--- a/luci/luci-app-qmodem-next/Makefile
+++ b/luci/luci-app-qmodem-next/Makefile
@@ -38,6 +38,7 @@ endef
 
 define Package/$(PKG_NAME)/install
 	$(CP) ./root/* $(1)/
+	$(INSTALL_DIR) $(1)/www
 	$(CP) ./htdocs/* $(1)/www/
 endef
 
