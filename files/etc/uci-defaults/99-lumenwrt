#!/bin/sh
# LumenWRT first-boot defaults. Runs once; removed after a successful run.
# A sysupgrade that keeps settings re-runs uci-defaults, so a marker in
# /etc/config/system (which is kept) stops us overwriting the user's changes.
[ "$(uci -q get system.@system[0].lumenwrt_defaults)" = 1 ] && exit 0

# System
uci -q batch <<-EOF
	set system.@system[0].hostname='LumenWRT'
	set system.@system[0].zonename='Asia/Kuala_Lumpur'
	set system.@system[0].timezone='<+08>-8'
	commit system
EOF

# NSS: software/hardware flow offloading and packet steering conflict with
# NSS ECM, so force them off (qosmio/openwrt-ipq README).
uci -q batch <<-EOF
	set firewall.@defaults[0].flow_offloading='0'
	set firewall.@defaults[0].flow_offloading_hw='0'
	commit firewall
	set network.globals.packet_steering='0'
	commit network
EOF

# Wi-Fi SSIDs/password/country come from /etc/board.d/99-lumenwrt.

# LuCI theme: Aurora by default (Bootstrap stays installed as a fallback)
uci -q batch <<-EOF
	set luci.themes.Aurora='/luci-static/aurora'
	set luci.main.mediaurlbase='/luci-static/aurora'
	commit luci
EOF

# TTL: rewrite TTL/hop limit of LAN traffic to 64 so tethering detection sees
# phone-like packets. NOTE: while enabled, luci-app-qmodem-ttlfw4 stops NSS ECM
# (routing falls back to the CPU) so every packet passes the nftables rule.
# Turn off under Modem > TTL to get NSS acceleration back.
uci -q batch <<-EOF
	set qmodem_ttl.main=main
	set qmodem_ttl.main.enable='1'
	set qmodem_ttl.main.ttl='64'
	commit qmodem_ttl
EOF
[ -x /etc/init.d/qmodem_ttl ] && /etc/init.d/qmodem_ttl enable

uci -q batch <<-EOF
	set system.@system[0].lumenwrt_defaults='1'
	commit system
EOF

exit 0
