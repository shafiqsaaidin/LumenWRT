#!/bin/sh
# LumenWRT: WAN interfaces and front-panel LEDs for the AW1000, matching the
# setup the device ran before LumenWRT. Named to sort after QModem's
# 99-qmodem-board (which only fills in missing options), so these win.
# Runs once per fresh config (marker survives keep-settings sysupgrades).
[ "$(uci -q get system.@system[0].lumenwrt_modem_defaults)" = 1 ] && exit 0

wan_zone() {
	uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -n1
}

# ---------------------------------------------------------------- WAN
# 5G modem (primary): interface "wwan" on the QMAP netdev, metric 11, default
# route. QModem's dialer manages it (modem_config = modem section for USB 4-1).
uci -q batch <<-EOF
	set network.wwan=interface
	set network.wwan.proto='dhcp'
	set network.wwan.device='wwan0_1'
	set network.wwan.ifname='wwan0_1'
	set network.wwan.modem_config='4_1'
	set network.wwan.metric='11'
	set network.wwan.defaultroute='1'
EOF

# Ethernet WAN port: DHCP client, but never takes the default route
# (5G stays primary even with a cable plugged in). IPv4 only, no wan6.
uci -q batch <<-EOF
	set network.wan=interface
	set network.wan.device='wan'
	set network.wan.proto='dhcp'
	set network.wan.defaultroute='0'
	delete network.wan6
	commit network
EOF

zone="$(wan_zone)"
if [ -n "$zone" ]; then
	uci -q del_list "firewall.$zone.network=wan6"
	uci -q del_list "firewall.$zone.network=wwan"
	uci -q add_list "firewall.$zone.network=wwan"
	uci -q commit firewall
fi

# QModem slot for the M.2 modem (USB 4-1): name the modem "wwan" so the dialer
# uses the interface above, metric 11. Upstream's AW1000 defaults point
# net_led/sim_led at LEDs that don't exist on this kernel (ipq::led9/led2);
# drop them so the dialer doesn't write junk LED sections.
uci -q batch <<-EOF
	set qmodem.usb0=modem-slot
	set qmodem.usb0.type='usb'
	set qmodem.usb0.slot='4-1'
	set qmodem.usb0.alias='wwan'
	set qmodem.usb0.default_metric='11'
	delete qmodem.usb0.net_led
	delete qmodem.usb0.sim_led
	delete qmodem.pcie0.net_led
	delete qmodem.pcie0.sim_led
	commit qmodem
EOF

# ---------------------------------------------------------------- LEDs
# All front-panel LEDs are driven by the QModem status script
# lumenwrt_aw1000.sh (signal/5G colours, Wi-Fi, SMS, internet, power).
# QModem starts only one modem_status per binding, so drop any other one.
for s in $(uci -q -X show qmodem_led | sed -n "s/^qmodem_led\.\([^.=]*\)=modem_status$/\1/p"); do
	[ "$s" = cellular ] || uci -q delete "qmodem_led.$s"
done
uci -q batch <<-EOF
	set qmodem_led.main=main
	set qmodem_led.cellular=modem_status
	set qmodem_led.cellular.enabled='1'
	set qmodem_led.cellular.script='lumenwrt_aw1000'
	set qmodem_led.cellular.bind='any'
	commit qmodem_led
EOF

# Remove the board's generic netdev LED rules for LEDs the script owns (and
# the WAN-port link LED, which the previous firmware also left off); otherwise
# /etc/init.d/led re-applies them after QModem's LED service has started.
for s in $(uci -q show system | sed -n "s/^system\.\([^.]*\)=led$/\1/p"); do
	case "$(uci -q get "system.$s.sysfs")" in
		green:5g|green:internet|*:green:wan) uci -q delete "system.$s" ;;
	esac
done
uci -q set system.@system[0].lumenwrt_modem_defaults='1'
uci -q commit system

exit 0
