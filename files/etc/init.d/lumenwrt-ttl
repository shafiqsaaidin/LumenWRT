#!/bin/sh /etc/rc.common
# LumenWRT: TTL / hop-limit rewrite for traffic leaving over the 5G modem, and
# the fw4 flow-offloading switch it depends on.
# Config: /etc/config/lumenwrt, sections 'ttl' (enabled, value) and 'offload'
# (enabled). Apply changes with 'reload_config' (LuCI's Apply does it):
# 'uci commit' alone does not run the reload trigger.
#
# Flow offloading (fw4 flowtable -> PPE/NSS) is OFF by default and forced off
# while TTL is on (offloaded flows skip nftables after their first packets).
#
# KNOWN ISSUE (2026-11-28, AW1000, ppe-nss 0514ded + wwand): with flow
# offloading on, LAN/Wi-Fi traffic over the modem stalls (hardware and
# software-only flowtable alike, with wwand QMAP and with mux_id 0), and stale
# NSS rules then hang new TLS handshakes until offloading is off again. Do not
# enable offload.enabled on this branch until that is fixed.

START=18
USE_PROCD=1

NFT=/etc/nftables.d/90-lumenwrt-ttl.nft

set_offload() {
	local want="$1" changed=0 opt
	for opt in flow_offloading flow_offloading_hw; do
		if [ "$(uci -q get "firewall.@defaults[0].$opt")" != "$want" ]; then
			uci -q set "firewall.@defaults[0].$opt=$want"
			changed=1
		fi
	done
	[ "$changed" = 1 ] && uci -q commit firewall
	return 0
}

apply() {
	local ttl value offload
	config_load lumenwrt
	config_get_bool ttl ttl enabled 0
	config_get value ttl value 64
	config_get_bool offload offload enabled 0
	case "$value" in ''|*[!0-9]*) value=64 ;; esac
	[ "$value" -ge 1 ] && [ "$value" -le 255 ] || value=64

	if [ "$ttl" = 1 ]; then
		cat > "$NFT.tmp" <<-EOF
			chain lumenwrt_ttl {
				type filter hook postrouting priority mangle; policy accept;
				oifname "wwand*" ip ttl set $value comment "LumenWRT TTL"
				oifname "wwand*" ip6 hoplimit set $value comment "LumenWRT hop limit"
			}
		EOF
		mv "$NFT.tmp" "$NFT"
		offload=0
		logger -t lumenwrt-ttl "TTL $value on wwand*"
	else
		rm -f "$NFT"
		# fw4 reload flushes rules but keeps chains it no longer defines
		nft delete chain inet fw4 lumenwrt_ttl 2>/dev/null
		logger -t lumenwrt-ttl "TTL rewrite off"
	fi
	set_offload "$offload"
	logger -t lumenwrt-ttl "flow offloading $([ "$offload" = 1 ] && echo on || echo off)"

	# At boot this runs before the firewall (S19), which then picks both up;
	# later changes need a reload of the running fw4 ruleset.
	if nft list table inet fw4 >/dev/null 2>&1; then
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
}

start_service() { apply; }
reload_service() { apply; }
stop_service() { :; }

service_triggers() {
	procd_add_reload_trigger lumenwrt
}
